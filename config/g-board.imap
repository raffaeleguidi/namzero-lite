<?xml version="1.0" encoding="UTF-8"?>
<!-- Configurazione attuale del G-Board (mode Program, canale 1).
     Pulsante 1 -> PC4 ... 4 -> PC7, 5 -> PC0 ... 8 -> PC3.
     Nel motore: pulsanti 1-4 = mod, 5-7 = drive, LED = nota del PC. -->
<map mode="Program" name="Program">
  <controls>
    <control id="1" kind="button" chan="1" value="4"/>
    <control id="2" kind="button" chan="1" value="5"/>
    <control id="3" kind="button" chan="1" value="6"/>
    <control id="4" kind="button" chan="1" value="7"/>
    <control id="5" kind="button" chan="1" value="0"/>
    <control id="6" kind="button" chan="1" value="1"/>
    <control id="7" kind="button" chan="1" value="2"/>
    <control id="8" kind="button" chan="1" value="3"/>
  </controls>
</map>
