[Unit]
Description=namzero-lite realtime guitar engine
After=sound.target
Wants=sound.target

[Service]
Type=simple
# Sostituisci "pi" con l'utente reale se diverso.
User=pi
Group=audio
WorkingDirectory=/home/pi/namzero-lite

ExecStart=/usr/local/bin/namzero-lite --device hw:1,0 --buffer 64 --rate 48000

# Thread audio: priorita' FIFO e core dedicato (deve combaciare con isolcpus).
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80
CPUAffinity=3
Nice=-10

LimitRTPRIO=95
LimitMEMLOCK=infinity

Restart=always
RestartSec=2

# Log volatile: niente scritture sulla SD.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
