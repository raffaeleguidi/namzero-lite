#!/bin/sh
# config: domande di debconf, eseguite PRIMA di scompatattare il pacchetto.
#
# Due modi per pilotarlo, in ordine di precedenza:
#   1. NAMZERO_INSTALL_MODE=desktop|service nell'ambiente (install.sh);
#   2. risposta gia' registrata in debconf (preseed o dpkg-reconfigure).
#
# Se nessuno dei due c'e', il default dipende dall'architettura: il Pi resta
# un apparecchio (service) senza che nessuno risponda a domande via SSH, il
# laptop parte in desktop. Calcolarlo qui e non nel template serve perche' il
# template ha un Default statico, mentre con frontend noninteractive debconf
# usa proprio quello.
set -e

. /usr/share/debconf/confmodule
db_version 2.0 || true

PKG=namzero-lite

case "${1:-}" in
configure | reconfigure)
    ;;
*)
    # abort-* e simili: non fare domande.
    exit 0
    ;;
esac

# ── 1. override da ambiente (install.sh interattivo) ──────────────────────
if [ -n "${NAMZERO_INSTALL_MODE:-}" ]; then
    case "$NAMZERO_INSTALL_MODE" in
    desktop | service)
        db_set "$PKG/install-mode" "$NAMZERO_INSTALL_MODE" || true
        ;;
    *)
        echo "$PKG: NAMZERO_INSTALL_MODE non valido: $NAMZERO_INSTALL_MODE" >&2
        echo "$PKG: valori ammessi: desktop, service" >&2
        exit 1
        ;;
    esac
    # Con un override esplicito non si fanno domande: chi installa ha gia'
    # deciso. Il valore resta registrato per dpkg-reconfigure.
    exit 0
fi

# ── 1b. migrazione da installazioni precedenti ────────────────────────────
# La modalita' "both" non esiste piu': chi l'aveva scelta teneva i dati in
# /etc/namzero e le unit attive, quindi il comportamento equivalente e'
# "service" (la GUI resta installata e si apre a mano).
db_get "$PKG/install-mode" || true
if [ "${RET:-}" = "both" ]; then
    db_set "$PKG/install-mode" service || true
fi

# ── 2. default: modalita' gia' installata, poi architettura ───────────────
# Prima si guarda cosa e' effettivamente installato (/var/lib/namzero/
# install-mode): senza questo, un dpkg-reconfigure con debconf vuoto (db
# ripulito, preseed parziale, immagine clonata) riporterebbe la macchina al
# default d'architettura, spegnendo i servizi a chi li stava usando.
MODE_FILE=/var/lib/namzero/install-mode
db_get "$PKG/install-mode" || true
if [ -z "${RET:-}" ] && [ -r "$MODE_FILE" ]; then
    _prev="$(tr -d '[:space:]' <"$MODE_FILE" 2>/dev/null || true)"
    case "$_prev" in
    desktop | service)
        db_set "$PKG/install-mode" "$_prev" || true
        ;;
    both)
        db_set "$PKG/install-mode" service || true
        ;;
    esac
fi

db_get "$PKG/install-mode" || true
if [ -z "${RET:-}" ]; then
    case "$(dpkg --print-architecture 2>/dev/null || echo unknown)" in
    arm64 | armhf)
        db_set "$PKG/install-mode" service || true
        ;;
    *)
        db_set "$PKG/install-mode" desktop || true
        ;;
    esac
fi

# Se la risposta e' gia' stata registrata da un preseed, non la si ripropone:
# chi ha preseminato ha gia' deciso. Con dpkg-reconfigure debconf azzera il
# flag 'seen' e la domanda torna a comparire, come deve essere.
db_fget "$PKG/install-mode" seen || true
if [ "${RET:-false}" != "true" ]; then
    db_input high "$PKG/install-mode" || true
    db_go || true
fi

# La domanda sull'utente ha senso solo se i dati sono condivisi (servizio).
db_get "$PKG/install-mode" || true
case "${RET:-desktop}" in
service)
    db_input low "$PKG/desktop-user" || true
    db_go || true
    ;;
esac

exit 0
